{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sources.yaml: źródła",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "version", "url", "location", "attribution", "usageNote"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "title": { "$ref": "common.schema.json#/$defs/text" },
          "version": { "$ref": "common.schema.json#/$defs/text" },
          "url": { "type": "string", "pattern": "^(https?://.+)?$", "description": "Adres http(s) albo pusty tekst." },
          "location": { "$ref": "common.schema.json#/$defs/text", "description": "Strony lub sekcje użyte w temacie." },
          "attribution": { "$ref": "common.schema.json#/$defs/markdown" },
          "usageNote": { "$ref": "common.schema.json#/$defs/text", "description": "Ograniczenia użycia. To nie jest zgoda na publikację." }
        }
      }
    }
  }
}
