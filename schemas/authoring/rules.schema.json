{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rules.yaml: reguły rozstrzygające",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "statement", "sources"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "revision": { "$ref": "common.schema.json#/$defs/revision" },
          "statement": { "$ref": "common.schema.json#/$defs/markdown", "description": "Treść reguły. Widoczna w oknie wiedzy." },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "location"],
              "properties": {
                "source": { "$ref": "common.schema.json#/$defs/id" },
                "location": { "$ref": "common.schema.json#/$defs/text" }
              }
            }
          }
        }
      }
    }
  }
}
